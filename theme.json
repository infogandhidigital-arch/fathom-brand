{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "name": "Deep Navy",
          "slug": "deep-navy",
          "color": "#1a2940"
        },
        {
          "name": "Active Blue",
          "slug": "active-blue",
          "color": "#0066cc"
        },
        {
          "name": "Off-White",
          "slug": "off-white",
          "color": "#f8f9fa"
        },
        {
          "name": "Accent Teal",
          "slug": "accent-teal",
          "color": "#00a8a8"
        },
        {
          "name": "Neutral Gray",
          "slug": "neutral-gray",
          "color": "#6b7280"
        },
        {
          "name": "Alert Red",
          "slug": "alert-red",
          "color": "#dc2626"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Inter\", \"Relative\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "name": "Fathom Sans",
          "slug": "fathom-sans"
        },
        {
          "fontFamily": "\"JetBrains Mono\", \"Fira Code\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "name": "Fathom Mono",
          "slug": "fathom-mono"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Base",
          "size": "1rem",
          "slug": "base"
        },
        {
          "name": "Medium",
          "size": "1.125rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "name": "XL",
          "size": "2rem",
          "slug": "xl"
        },
        {
          "name": "Display",
          "size": "3rem",
          "slug": "display"
        }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "name": "2XS",
          "slug": "2xs",
          "size": "0.25rem"
        },
        {
          "name": "XS",
          "slug": "xs",
          "size": "0.5rem"
        },
        {
          "name": "S",
          "slug": "s",
          "size": "0.75rem"
        },
        {
          "name": "M",
          "slug": "m",
          "size": "1rem"
        },
        {
          "name": "L",
          "slug": "l",
          "size": "1.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "2rem"
        },
        {
          "name": "2XL",
          "slug": "2xl",
          "size": "3rem"
        },
        {
          "name": "3XL",
          "slug": "3xl",
          "size": "4rem"
        }
      ]
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fathom-sans)",
          "fontWeight": "700"
        },
        "color": {
          "text": "var(--wp--preset--color--deep-navy)"
        }
      },
      "core/paragraph": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fathom-sans)",
          "lineHeight": "1.6"
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fathom-mono)",
          "fontSize": "0.875rem"
        }
      },
      "core/preformatted": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fathom-mono)",
          "fontSize": "0.875rem"
        }
      }
    },
    "custom": {
      "fathom": {
        "contentPillars": [
          {
            "slug": "ai-technology",
            "label": "AI & Technology",
            "color": "#0066cc"
          },
          {
            "slug": "marketing-growth",
            "label": "Marketing & Growth",
            "color": "#00a8a8"
          },
          {
            "slug": "research-analysis",
            "label": "Research & Analysis",
            "color": "#1a2940"
          },
          {
            "slug": "business-strategy",
            "label": "Business & Strategy",
            "color": "#6b7280"
          }
        ],
        "contentTypes": [
          "research-post",
          "explainer",
          "curation",
          "analysis",
          "framework"
        ]
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--off-white)",
      "text": "var(--wp--preset--color--deep-navy)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--fathom-sans)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--deep-navy)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fathom-sans)",
          "fontWeight": "700",
          "letterSpacing": "-0.01em"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--active-blue)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-teal)"
          }
        }
      },
      "button": {
        "border": {
          "radius": "4px"
        },
        "color": {
          "background": "var(--wp--preset--color--active-blue)",
          "text": "var(--wp--preset--color--off-white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fathom-sans)",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "0.6rem",
            "right": "1rem",
            "bottom": "0.6rem",
            "left": "1rem"
          }
        }
      }
    },
    "blocks": {
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--accent-teal)",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "1rem"
          }
        },
        "typography": {
          "fontStyle": "normal"
        }
      },
      "core/separator": {
        "color": {
          "background": "var(--wp--preset--color--neutral-gray)",
          "text": "var(--wp--preset--color--neutral-gray)"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "0.875rem",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--active-blue)"
        }
      }
    },
    "variations": [
      {
        "name": "research-post",
        "title": "Research Post",
        "styles": {
          "blocks": {
            "core/post-title": {
              "typography": {
                "fontSize": "2.5rem",
                "fontWeight": "700"
              }
            },
            "core/pullquote": {
              "border": {
                "color": "var(--wp--preset--color--active-blue)"
              }
            }
          }
        }
      },
      {
        "name": "explainer",
        "title": "Explainer",
        "styles": {
          "spacing": {
            "blockGap": "1.25rem"
          },
          "blocks": {
            "core/list": {
              "spacing": {
                "blockGap": "0.5rem"
              }
            }
          }
        }
      },
      {
        "name": "curation",
        "title": "Curation",
        "styles": {
          "blocks": {
            "core/group": {
              "border": {
                "color": "var(--wp--preset--color--neutral-gray)",
                "width": "1px"
              },
              "spacing": {
                "padding": {
                  "top": "1rem",
                  "right": "1rem",
                  "bottom": "1rem",
                  "left": "1rem"
                }
              }
            }
          }
        }
      }
    ]
  },
  "customTemplates": [
    {
      "name": "research-post",
      "title": "Research Post",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "explainer",
      "title": "Explainer",
      "postTypes": [
        "post"
      ]
    },
    {
      "name": "curation-digest",
      "title": "Curation Digest",
      "postTypes": [
        "post"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Site Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site Footer",
      "area": "footer"
    },
    {
      "name": "sidebar-research",
      "title": "Research Sidebar",
      "area": "uncategorized"
    }
  ],
  "patterns": [
    "fathom/research-hero",
    "fathom/explainer-summary",
    "fathom/curation-digest",
    "fathom/content-pillar-grid",
    "fathom/data-callout"
  ]
}
